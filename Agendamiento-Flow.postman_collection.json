{
  "info": {
    "name": "Agendamiento Flow",
    "_postman_id": "6f6c2d22-2222-4c4a-bbbb-000000000002",
    "description": "Crear paciente, crear médico y agendar turno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "AGENDAMIENTO_URL", "value": "http://localhost:8081" },
    { "key": "MEDICOS_URL", "value": "http://localhost:8082" },
    { "key": "PACIENTES_URL", "value": "http://localhost:8083" }
  ],
  "item": [
    {
      "name": "1) Crear Paciente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{PACIENTES_URL}}/api/pacientes", "host": ["{{PACIENTES_URL}}"], "path": ["api","pacientes"] },
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana Perez\",\n  \"email\": \"ana@mail.com\",\n  \"telefono\": \"555-1000\",\n  \"activo\": true\n}" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('200/201 OK', () => pm.expect([200,201]).to.include(pm.response.code));",
            "let j={}; try{ j=pm.response.json(); }catch(e){ }",
            "pm.expect(j).to.have.property('id');",
            "pm.collectionVariables.set('pacienteId', j.id);"
          ],
          "type": "text/javascript"
        }
      }]
    },
    {
      "name": "2) Crear Médico",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{MEDICOS_URL}}/api/medicos", "host": ["{{MEDICOS_URL}}"], "path": ["api","medicos"] },
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Dr. Lopez\",\n  \"especialidad\": \"Clinica\",\n  \"activo\": true\n}" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('200/201 OK', () => pm.expect([200,201]).to.include(pm.response.code));",
            "let j={}; try{ j=pm.response.json(); }catch(e){ }",
            "pm.expect(j).to.have.property('id');",
            "pm.collectionVariables.set('medicoId', j.id);"
          ],
          "type": "text/javascript"
        }
      }]
    },
    {
      "name": "3) Agendar Turno",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const d = new Date(Date.now() + 24*60*60*1000);",
              "const pad = n => String(n).padStart(2,'0');",
              "const fh = d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes());",
              "pm.collectionVariables.set('FECHA_HORA', fh);",
              "console.log('FECHA_HORA', fh);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Respuesta 201 Created', () => pm.response.to.have.status(201));",
              "let j={}; try{ j=pm.response.json(); }catch(e){ console.warn('No JSON:', pm.response.text()); }",
              "if (pm.response.code === 201) {",
              "  pm.test('Estado CONFIRMADO', () => pm.expect(j.estado).to.eql('CONFIRMADO'));",
              "  pm.collectionVariables.set('turnoId', j.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{AGENDAMIENTO_URL}}/api/turnos", "host": ["{{AGENDAMIENTO_URL}}"], "path": ["api","turnos"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteId\": {{pacienteId}},\n  \"medicoId\": {{medicoId}},\n  \"fechaHora\": \"{{FECHA_HORA}}\"\n}"
        }
      }
    }
  ]
}
